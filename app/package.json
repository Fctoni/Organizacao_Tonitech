{
  "name": "tonitech-inventory",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "dev:local": "node scripts/dev-local.mjs",
    "build": "tsc --noEmit && vite build",
    "test": "node --test tests/*.test.mjs",
    "test:integration": "node scripts/integration.mjs && node scripts/password-integration.mjs && node scripts/import-integration.mjs",
    "import": "node scripts/import.mjs",
    "db:verify": "node scripts/verify.mjs"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.99.0",
    "mdast-util-to-string": "^4.0.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "react-markdown": "^10.1.0"
  },
  "devDependencies": {
    "@types/mdast": "^4.0.4",
    "@types/node": "^25.0.0",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "typescript": "^5.9.0",
    "vite": "^7.3.0"
  }
}
