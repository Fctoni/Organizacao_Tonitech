{
  "name": "tonitech-inventory",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "engines": {
    "node": ">=22.18.0"
  },
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "dev:local": "node scripts/dev-local.mjs",
    "build": "tsc --noEmit && vite build",
    "test": "node --test tests/*.test.mjs",
    "test:chat:integration": "node scripts/chat-integration.mjs",
    "test:mcp:integration": "node scripts/mcp-integration.mjs",
    "test:mcp:cleanup": "node scripts/mcp-cleanup-check.mjs",
    "test:assistant:db": "node scripts/assistant-db-check.mjs",
    "test:integration": "node scripts/integration.mjs && node scripts/password-integration.mjs && node scripts/import-integration.mjs",
    "import": "node scripts/import.mjs",
    "db:verify": "node scripts/verify.mjs"
  },
  "dependencies": {
    "@ai-sdk/google": "4.0.102",
    "@ai-sdk/react": "4.0.152",
    "@modelcontextprotocol/node": "2.1.1",
    "@modelcontextprotocol/server": "2.3.1",
    "@supabase/supabase-js": "^2.99.0",
    "ai": "7.0.148",
    "jose": "6.2.13",
    "mdast-util-to-string": "^4.0.0",
    "pg": "8.23.1",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "react-markdown": "^10.1.0",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@modelcontextprotocol/client": "2.3.1",
    "@types/mdast": "^4.0.4",
    "@types/node": "^25.0.0",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "typescript": "^5.9.0",
    "vite": "^7.3.0"
  }
}
