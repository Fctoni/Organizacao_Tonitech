VITE_SUPABASE_URL=https://PROJECT.supabase.co
VITE_SUPABASE_ANON_KEY=PUBLIC_ANON_KEY
# Apenas no ambiente servidor Vercel, nunca prefixar com VITE_:
SUPABASE_URL=https://PROJECT.supabase.co
SUPABASE_ANON_KEY=PUBLIC_ANON_KEY
SUPABASE_SERVICE_ROLE_KEY=SERVER_ONLY
# Chat: exclusivamente servidor. Escolha o modelo no AI Studio; não há default.
GEMINI_MODEL=
GOOGLE_GENERATIVE_AI_API_KEY=
# Segredo aleatório próprio, mínimo 32 caracteres. Não use chave pública Supabase.
CHAT_SIGNING_SECRET=
# MCP: somente servidor; preencher após pré-registro OAuth e provisionamento privado.
MCP_RESOURCE_URL=https://tonitech-inventario.vercel.app/api/mcp
MCP_CLIENT_ID=
MCP_DATABASE_URL=
# Opcional: CA PEM confiável para Supavisor; TLS sempre verifica o certificado.
MCP_DATABASE_CA=
